---
// A dark-mode screenshot shown as an app window. Click to open it full size.
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  // Rendered width hint for the in-page image (CSS sizes attribute).
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes = "(max-width: 900px) 100vw, 1200px",
  eager = false,
  class: className,
} = Astro.props;

const full = await getImage({
  src,
  width: Math.min(src.width, 2600),
  format: "webp",
  quality: 90,
});
---

<figure class:list={["shot", className]}>
  <button
    class="shot-open"
    type="button"
    data-lightbox-open
    aria-label={`Open full size: ${alt}`}
  >
    <span class="shot-bar" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <Image
      src={src}
      alt={alt}
      widths={[480, 800, 1200, 1800]}
      sizes={sizes}
      format="webp"
      quality={85}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
    />
    <span class="shot-zoom" aria-hidden="true">⤢</span>
  </button>

  <dialog class="shot-dialog" aria-label={alt}>
    <form method="dialog">
      <button class="shot-close" aria-label="Close">×</button>
    </form>
    <img
      src={full.src}
      alt={alt}
      width={full.attributes.width}
      height={full.attributes.height}
      loading="lazy"
      decoding="async"
    />
  </dialog>
</figure>

<style>
  .shot {
    margin: 0;
  }

  .shot-open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(185, 227, 201, 0.16);
    border-radius: 12px;
    background: #121733;
    box-shadow: 0 24px 60px -30px rgba(5, 10, 8, 0.6);
    cursor: zoom-in;
    text-align: left;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  .shot-open:hover,
  .shot-open:focus-visible {
    border-color: rgba(185, 227, 201, 0.45);
  }

  .shot-bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: #171d3d;
  }

  .shot-bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .shot-open :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot-zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: rgba(12, 26, 19, 0.75);
    color: var(--color-signal);
    font-size: 0.95rem;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .shot-open:hover .shot-zoom,
  .shot-open:focus-visible .shot-zoom {
    opacity: 1;
  }

  .shot-dialog {
    width: min(96vw, 1800px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    overflow: auto;
    border: 1px solid rgba(185, 227, 201, 0.25);
    border-radius: 12px;
    background: #121733;
  }

  .shot-dialog::backdrop {
    background: rgba(6, 10, 8, 0.85);
  }

  .shot-dialog img {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-out;
  }

  .shot-dialog form {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    height: 0;
  }

  .shot-close {
    margin: 0.6rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: rgba(12, 26, 19, 0.85);
    color: var(--color-surface);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-lightbox-open]").forEach((button) => {
    const dialog = button.parentElement?.querySelector("dialog");
    if (!dialog) return;
    button.addEventListener("click", () => dialog.showModal());
    // Clicking the image or the backdrop closes it.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog || (event.target as HTMLElement).tagName === "IMG") {
        dialog.close();
      }
    });
  });
</script>
