---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="placeholder">
    <div class="site-container">
      <p class="eyebrow">Eldritch, Inc.</p>

      <h1>
        We build software that makes
        AI systems better.
      </h1>

      <p class="lede">
        Eldritch builds infrastructure for constructing,
        evaluating, and optimizing AI systems.
      </p>
    </div>
  </section>
</Layout>

<style>
  .placeholder {
    display: flex;
    min-height: 65vh;
    align-items: center;
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .lede {
    max-width: 650px;
    margin: 2rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
  }
</style>