---
import Lifecycle from "../components/Lifecycle.astro";
import Tendrils from "../components/Tendrils.astro";
import Layout from "../layouts/Layout.astro";
import { azathoth, site } from "../data/site";

const loop = [
  {
    name: "Benchmark",
    text: "Turn your real cases into a test set, then measure what today's workflow costs, how fast it runs, and how often it's right.",
  },
  {
    name: "Optimize",
    text: "Try cheaper models one step at a time. Each candidate runs against the same benchmark, and the measurements pick the winner.",
  },
  {
    name: "Promote",
    text: "Nothing reaches production until someone deliberately promotes the winner. Every promotion is kept as an audit record.",
  },
];

const audiences = [
  {
    who: "Platform & DevOps",
    hear: "Operate AI like any other service: a command line, Postgres, queues, containers, tracing, resumable runs.",
  },
  {
    who: "Engineering leaders",
    hear: "Developers build tools once. Domain experts compose workflows from them. Prompt and model changes stop needing a redeploy.",
  },
  {
    who: "Finance & cost owners",
    hear: "See what every step of every run cost, and find cheaper models that pass the same benchmark.",
  },
  {
    who: "Risk & compliance",
    hear: "An approved model list, least-privilege tools, append-only history, traces that never carry content, and agents that reach only the tools you list.",
  },
  {
    who: "AWS shops",
    hear: "Amazon Bedrock built in, and a CloudFormation template for Fargate included, with end-to-end validation in progress. A better home for AI workflows than Step Functions.",
  },
  {
    who: "Teams rolling out agents",
    hear: "Give agents real capability without giving up control: a scope per tool, your own identity provider, and a full audit trail.",
  },
];
---

<Layout
  description="Cut what your AI workflows cost and prove quality held. Azathoth is an open-source engine that runs in your own environment, and serves your promoted workflows to AI agents as governed tools."
>
  <section class="hero section-dark">
    <Tendrils />

    <div class="site-container hero-inner">
      <a class="pill" href="/azathoth#agents">
        Azathoth {azathoth.version}: your workflows as agent tools (MCP)
      </a>

      <h1 class="display">
        Cut your AI costs.
        <span class="signal">Prove quality held.</span>
      </h1>

      <p class="lede">
        Eldritch benchmarks, optimizes and governs the AI workflows your
        company already runs, using Azathoth, our open-source engine that
        runs in your own environment. Every change comes with the evidence
        behind it.
      </p>

      <div class="actions">
        <a
          class="button button-signal"
          href={site.booking}
          target="_blank"
          rel="noreferrer"
        >
          {site.bookingLabel}
          <span aria-hidden="true">↗</span>
        </a>

        <a class="button button-ghost" href="/workwithus">
          See how we work
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="hero-facts" aria-label="At a glance">
        <li>Open source</li>
        <li>Runs in your environment</li>
        <li>OpenRouter &amp; Amazon Bedrock</li>
        <li>Nothing ships without proof</li>
      </ul>
    </div>
  </section>

  <section class="section problem">
    <div class="site-container split">
      <div>
        <p class="eyebrow">The problem</p>
        <h2 class="heading">
          Nobody can say what your AI is really costing you.
        </h2>
      </div>

      <div class="questions">
        <p class="questions-intro">
          Most AI workflows live inside application code or inside a model
          provider's agent loop. So the basic questions go unanswered:
        </p>

        <ul>
          <li>Which model does each step actually need?</li>
          <li>Would a cheaper one do just as well?</li>
          <li>What did yesterday's runs cost, step by step?</li>
          <li>Why did last week's output change?</li>
        </ul>

        <p class="questions-outro">
          Changing a prompt or a model means a code deploy, and the
          provider owns the flow. We think you should own it.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-dark how">
    <div class="site-container">
      <div class="how-heading">
        <p class="eyebrow eyebrow-light">How it works</p>
        <h2 class="heading">
          Measure. Improve.
          Ship on purpose.
        </h2>
        <p class="lede">
          Azathoth records every step of every run as evidence: which model
          ran, what it was given, what it cost, how long it took. That record
          is what makes safe optimization possible.
        </p>
      </div>

      <Lifecycle
        stages={loop}
        label="Benchmark, optimize, promote: all three write to one evidence store"
        store="Every step is evidence"
      />
    </div>
  </section>

  <section class="section agents">
    <div class="site-container split">
      <div>
        <p class="eyebrow">New in Azathoth {azathoth.version}</p>
        <h2 class="heading">Let agents use your workflows, on your terms.</h2>
      </div>

      <div class="prose">
        <p>
          Your best workflows can now be tools for AI agents: Claude Desktop,
          your IDE, or the agents your company builds.
        </p>

        <p>
          Agents see only the workflows you list. They run only what you've
          promoted, reach only the tools their token allows, and every call
          is recorded with who made it.
        </p>

        <p class="emphasis">
          It runs in your environment, behind your own identity provider.
        </p>

        <div class="actions">
          <a class="text-link" href="/azathoth#agents">
            How agent access works <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="/workwithus#engagements">
            The Agent Access Pilot <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section audiences">
    <div class="site-container">
      <div class="split audiences-heading">
        <div>
          <p class="eyebrow">Who it's for</p>
          <h2 class="heading">AI work, moved into operations.</h2>
        </div>

        <p class="lede">
          Developers build tools. Experts compose workflows from them.
          Platform teams run, benchmark, optimize and promote them. Each
          person does the part they're good at.
        </p>
      </div>

      <div class="audience-grid">
        {
          audiences.map((audience) => (
            <article>
              <h3>{audience.who}</h3>
              <p>{audience.hear}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-accent offer">
    <div class="site-container split">
      <div>
        <p class="eyebrow eyebrow-light">Start small</p>
        <h2 class="heading">
          One workflow.
          Two weeks.
          Real numbers.
        </h2>
      </div>

      <div class="prose">
        <p>
          In a <strong>Workflow Cost Audit</strong>, we rebuild one of your
          AI workflows in Azathoth, build a benchmark from your real cases,
          and run optimization against it.
        </p>

        <p class="emphasis">
          You get a report comparing what you pay today with two or three
          cheaper options, each with measured quality, latency and cost.
          Evidence, not opinion.
        </p>

        <div class="actions">
          <a
            class="button button-signal"
            href={site.booking}
            target="_blank"
            rel="noreferrer"
          >
            {site.bookingLabel}
            <span aria-hidden="true">↗</span>
          </a>

          <a class="button button-ghost" href="/workwithus">
            Offers &amp; pricing
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="site-container split">
      <div>
        <p class="eyebrow">Built to be checked</p>
        <h2 class="heading">Every claim, measured.</h2>
      </div>

      <div class="proof-list">
        <article>
          <h3>Judged the same way, every time</h3>
          <p>
            Results are scored by exact match, normalized match, JSON
            schema, or an AI judge. Every candidate faces the same judge
            on the same case.
          </p>
        </article>

        <article>
          <h3>Failures can't win on price</h3>
          <p>
            A run that fails scores zero and earns no credit for speed or
            cost, so a cheap model that breaks never looks like a bargain.
          </p>
        </article>

        <article>
          <h3>Nothing is edited in place</h3>
          <p>
            Every workflow, run, experiment and promotion is kept as a
            permanent revision. You can always see what changed, when, and
            why, and roll back by re-importing.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section founder">
    <div class="site-container founder-grid">
      <div class="portrait">
        <img
          src="/images/eris-discordia-montano.jpeg"
          alt="Eris Discordia Montano, founder of Eldritch, Inc."
          loading="lazy"
          width="1062"
          height="1056"
        />
      </div>

      <div>
        <p class="eyebrow">Who you'll work with</p>
        <h2 class="heading">Eris Discordia Montano</h2>
        <p class="role">Founder &amp; Principal Engineer</p>

        <div class="prose">
          <p>
            Thirty years building systems people depend on: early online
            game worlds, a cell-tower alerting system Nextel's engineers
            relied on for years, and systems for healthcare, pharma,
            logistics and agriculture companies.
          </p>

          <p>
            She brought GPT-3.5 into Ocelot Consulting when the field was
            brand new and started the firm down the path to AI consulting.
            Then she built Azathoth, solo and in the open, from first commit
            to {azathoth.version} in just over three months.
          </p>
        </div>

        <a class="text-link" href="/about">
          More about Eris and Eldritch
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section open-source">
    <div class="site-container split">
      <div>
        <p class="eyebrow">Open source</p>
        <h2 class="heading">Try it yourself.</h2>
        <p class="lede">
          Azathoth is free and open source. Your team can install it today
          and run it on a laptop. A CloudFormation template for AWS is
          included, with end-to-end validation in progress.
        </p>
      </div>

      <div class="install">
        <div class="command" aria-label="Install command">
          <code>pip install {azathoth.pypiName}</code>
        </div>

        <div class="actions">
          <a class="button button-primary" href="/azathoth">
            Explore Azathoth
            <span aria-hidden="true">→</span>
          </a>

          <a
            class="button button-secondary"
            href={azathoth.repo}
            target="_blank"
            rel="noreferrer"
          >
            View on GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark closing">
    <Tendrils side="left" />

    <div class="site-container closing-inner">
      <div>
        <p class="eyebrow eyebrow-light">Next step</p>
        <h2 class="heading">
          Bring us one workflow.
          We'll show you what it should cost.
        </h2>
      </div>

      <div class="actions">
        <a
          class="button button-signal"
          href={site.booking}
          target="_blank"
          rel="noreferrer"
        >
          Book a review
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    min-height: calc(100vh - 5rem);
    align-items: center;
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .hero .display {
    max-width: 1000px;
    margin-top: 2.25rem;
  }

  .signal {
    display: block;
    color: var(--color-signal);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding: 0;
    margin: 3.5rem 0 0;
    list-style: none;
    color: var(--color-sage);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .hero-facts li::before {
    content: "✓";
    margin-right: 0.5rem;
    color: var(--color-signal);
  }

  .questions-intro,
  .questions-outro {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .questions ul {
    padding: 0;
    margin: 2rem 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .questions li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .questions-outro {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .how-heading {
    max-width: 820px;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .audiences-heading {
    align-items: end;
  }

  .audiences-heading .lede {
    margin: 0;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .audience-grid article {
    padding: 2rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .audience-grid h3,
  .proof-list h3 {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
  }

  .audience-grid p,
  .proof-list p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .offer .prose strong {
    color: var(--color-surface);
  }

  .proof-list {
    border-top: 1px solid var(--color-border);
  }

  .proof-list article {
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .founder-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .portrait {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-border);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .role {
    margin: 1rem 0 2rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .agents .actions {
    gap: 2rem;
  }

  .install .actions {
    margin-top: 1.5rem;
  }

  .closing .closing-inner {
    position: relative;
  }

  @media (max-width: 900px) {
    .audience-grid {
      grid-template-columns: 1fr 1fr;
    }

    .founder-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 420px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: auto;
    }

    .audience-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
