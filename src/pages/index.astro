---
const title = "Eldritch, Inc.";
const description =
  "Eldritch builds software for constructing, evaluating, and optimizing AI systems.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="description"
      content={description}
    />
    <title>{title}</title>
  </head>

  <body>
    <main>
      <h1>Eldritch, Inc.</h1>
      <p>
        We build software that makes AI systems better.
      </p>
    </main>
  </body>
</html>