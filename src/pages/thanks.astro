---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thanks"
  description="Thanks for signing up."
  noindex
>
  <section class="section">
    <div class="site-container">
      <p class="eyebrow">Thanks</p>
      <h1 class="heading">You're on the list.</h1>
      <p class="lede">
        We've got your details and we'll be in touch. Questions in the
        meantime? Email <a href="mailto:eris@eldritchinc.com">eris@eldritchinc.com</a>.
      </p>
      <div class="actions">
        <a class="button button-primary" href="/news">Back to News <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>
