---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout
  title="Contact"
  description="Book a 30-minute workflow review, or contact Eldritch, Inc. about Azathoth, AI workflow optimization, collaboration, or investment."
>
  <section class="hero">
    <div class="site-container hero-inner">
      <p class="eyebrow">Contact</p>

      <h1>
        Talk to
        Eldritch.
      </h1>

      <p class="lede">
        The fastest way to start is a free 30-minute workflow review.
        We’re also glad to talk about Azathoth, open-source collaboration,
        and investment.
      </p>
    </div>
  </section>

  <section class="contact">
    <div class="site-container contact-grid">
      <div>
        <p class="eyebrow">Direct contact</p>

        <h2>
          Eris Discordia Montano
        </h2>

        <p class="role">
          Founder & Principal Engineer
        </p>
      </div>

      <div class="details">
        <article>
          <p class="label">Book a call</p>

          <a href={site.booking} target="_blank" rel="noreferrer">
            30-minute workflow review
            <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article>
          <p class="label">Email</p>

          <a href="mailto:eris@eldritchinc.com">
            eris@eldritchinc.com
            <span aria-hidden="true">→</span>
          </a>
        </article>

        <article>
          <p class="label">GitHub</p>

          <a
            href="https://github.com/EldritchInc"
            target="_blank"
            rel="noreferrer"
          >
            github.com/EldritchInc
            <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article>
          <p class="label">Location</p>

          <p class="value">
            Brooklyn, New York
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="conversation">
    <div class="site-container conversation-grid">
      <div>
        <p class="eyebrow eyebrow-light">Start a conversation</p>

        <h2>
          Building something
          difficult?
        </h2>
      </div>

      <div class="conversation-copy">
        <p>
          If your company runs AI workflows in production, bring one to a
          30-minute call. We’ll talk about what it does, what it costs, and
          whether a fixed-price Workflow Cost Audit would pay for itself.
          Engineers, contributors and investors are welcome too.
        </p>

        <a
          class="button"
          href={site.booking}
          target="_blank"
          rel="noreferrer"
        >
          {site.bookingLabel}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(6rem, 13vw, 12rem);
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow-light {
    color: #9dbbac;
  }

  .hero h1 {
    max-width: 950px;
    margin: 0;
    font-size: clamp(4rem, 9vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .lede {
    max-width: 720px;
    margin: 2.5rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .contact {
    padding-block: clamp(6rem, 12vw, 11rem);
    border-bottom: 1px solid var(--color-border);
  }

  .contact-grid,
  .conversation-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 9rem);
  }

  .contact h2,
  .conversation h2 {
    margin: 0;
    font-size: clamp(2.75rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .role {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-weight: 700;
  }

  .details {
    border-top: 1px solid var(--color-border);
  }

  .details article {
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .label {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .details a {
    display: inline-flex;
    gap: 0.75rem;
    color: var(--color-foreground);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 600;
    text-decoration: none;
  }

  .details a:hover,
  .details a:focus-visible {
    color: var(--color-accent);
  }

  .value {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 600;
  }

  .conversation {
    background: var(--color-foreground);
    color: var(--color-surface);
  }

  .conversation-grid {
    padding-block: clamp(7rem, 14vw, 13rem);
  }

  .conversation-copy {
    max-width: 650px;
  }

  .conversation-copy p {
    margin: 0;
    color: #b8bdb9;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 3.25rem;
    margin-top: 2.5rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-surface);
    color: var(--color-surface);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .button:hover,
  .button:focus-visible {
    background: var(--color-surface);
    color: var(--color-foreground);
  }

  @media (max-width: 800px) {
    .contact-grid,
    .conversation-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: clamp(3.5rem, 18vw, 5.5rem);
    }

    .details a {
      overflow-wrap: anywhere;
    }

    .button {
      justify-content: space-between;
      width: 100%;
    }
  }
</style>