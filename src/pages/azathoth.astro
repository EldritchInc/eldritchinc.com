---
import Lifecycle from "../components/Lifecycle.astro";
import Tendrils from "../components/Tendrils.astro";
import Layout from "../layouts/Layout.astro";
import { azathoth, mcp, site } from "../data/site";

const lifecycle = [
  { name: "Compose", text: "Workflows are plain documents of steps and tools. No application code." },
  { name: "Run", text: "The engine runs every step itself and records exactly what each model saw." },
  { name: "Benchmark", text: "Score the workflow against your real cases for quality, speed and cost." },
  { name: "Optimize", text: "Try cheaper compatible models, step by step. Evidence picks the winner." },
  { name: "Promote", text: "Deliberately make the winner the production version, with an audit record." },
  { name: "Invoke", text: "Production runs exactly what was promoted, whether the call comes from the CLI, a queue, or an AI agent." },
];

const roles = [
  {
    who: "Developers",
    does: "build tools",
    text: "Tools are versioned capabilities with clear inputs and outputs: Python, or any command. Built once, reused everywhere.",
  },
  {
    who: "Domain experts",
    does: "compose workflows",
    text: "Experts and analysts assemble workflows from those tools as plain JSON documents, then test them, without writing code.",
  },
  {
    who: "Platform teams",
    does: "run the show",
    text: "Run, benchmark, optimize, promote and operate everything from the command line, like any other production service.",
  },
];

const highlights = [
  {
    label: "New in 1.3",
    area: "Documents & citations",
    items: [
      "PDFs and images in, from local files or S3",
      "Citations checked against the text, with no model involved",
      "Anchored to the exact words, page and position",
      "Exported as W3C Web Annotations, with links to the cited page",
    ],
  },
  {
    label: "Serve and call",
    area: "Agents & MCP",
    items: [
      "Promoted workflows served as MCP tools, with their schemas",
      "OAuth 2.1 resource server with a scope per tool",
      "Every invocation audited with its caller",
      "Workflow steps can call tools other MCP servers serve",
    ],
  },
];

const documentFlow = [
  {
    name: "Documents in",
    text: "Workflows accept PDFs and images by reference, from local files or S3. A standard tool divides a PDF into citable segments.",
  },
  {
    name: "Citations checked",
    text: "When a step cites a passage, it's checked against the document's own text before it's kept, and anchored to the exact words, page and position on the page.",
  },
  {
    name: "Models that read",
    text: "A step can show the PDF or image itself to a model that reads it, on OpenRouter or Amazon Bedrock.",
  },
  {
    name: "Provenance out",
    text: "Citations export as W3C Web Annotations that point back into the source, with S3 objects pinned by version. One command gives a link to the cited page.",
  },
];

const features = [
  {
    area: "Composition",
    items: [
      "Steps that run in parallel, with results recorded in a fixed order",
      "Routing on conditions, so each case goes to the right specialist",
      "Retries, fallbacks and failure policies per step",
      "Workflows that call, loop over, and fan out to other workflows",
    ],
  },
  {
    area: "Models",
    items: [
      "Hundreds of models through OpenRouter, plus Amazon Bedrock",
      "An approved model list your organization controls",
      "Mix models step by step: the cheap one where it's enough",
      "Explicit failover to named substitutes if a model goes offline",
    ],
  },
  {
    area: "Evaluation",
    items: [
      "Benchmarks built from real cases, versioned like code",
      "Four ways to score: exact, normalized, schema, or AI judge",
      "Thumbs-up and thumbs-down feedback on real runs",
      "Failed runs score zero, so broken never looks cheap",
    ],
  },
  {
    area: "Optimization",
    items: [
      "Searches for strictly cheaper models that hold quality",
      "Keeps today's version in every round for a fair comparison",
      "Every experiment saved for inspection",
      "Never deploys on its own. Promotion is always explicit",
    ],
  },
  {
    area: "Production",
    items: [
      "A versioned JSON job interface: one request in, one result out",
      "Idempotent invocations, so retries never double-run",
      "Interrupted runs resume where they stopped",
      "Files of any size, split and processed in parallel",
      "Workflow contracts: input and result schemas enforced on every call",
    ],
  },
  {
    area: "Operations",
    items: [
      "Every operation available from bash",
      "Append-only history; revert by re-importing",
      "SQLite on a laptop, PostgreSQL in production",
      "OpenTelemetry tracing that never carries content",
    ],
  },
];

const examples = [
  { name: "Code review", text: "Three reviewers run at once (security, correctness, readability), and a lead reviewer steps in only when there are findings." },
  { name: "Ticket triage", text: "Each ticket is routed to exactly one of four specialists, policy-checked, and escalated to a stronger model when confidence is low." },
  { name: "Novel writer", text: "Plans, outlines and writes a book, each chapter through its own edit-and-verify loop until the story ends." },
  { name: "Workflow writer", text: "A workflow that writes, and validates, new Azathoth workflows." },
  { name: "Large files", text: "Counts words across a file of any size in S3 by splitting it and processing the pieces in parallel." },
  { name: "The basics", text: "Prompts, sentiment, redundant producers, loops and maps: small examples to learn from." },
  { name: "Claim documents", text: "Segments a two-page sample claim PDF and answers questions about it, each answer citing the page it came from." },
  { name: "MCP tools", text: "Workflows whose steps call tools that other MCP servers serve." },
];

const guarantees = [
  {
    name: "Only promoted workflows run",
    text: "Each call runs the active production revision. The server won't start if a listed workflow hasn't been promoted, and re-promoting takes effect without a restart.",
  },
  {
    name: "Only what you list is exposed",
    text: "You choose each workflow, its tool name and the description the model sees, and each tool carries the workflow's input and result schemas. There is no \"run anything\" tool, and promotion and optimization are never offered.",
  },
  {
    name: "One scope per tool",
    text: "Tokens come from your own identity provider, and a caller sees only the tools its token allows.",
  },
  {
    name: "Every call recorded with its caller",
    text: "Each invocation records who called and how. One lookup shows the input, the outcome and every step of the run.",
  },
  {
    name: "Retries never double-run",
    text: "Repeating a call with the same idempotency key returns the recorded result, and interrupted calls resume where they stopped.",
  },
];

const comparison = [
  ["The engine owns the flow; models only answer prompts", "The model drives the loop as an agent"],
  ["Agents see only the tools an operator listed, scoped per caller, with every call audited", "Agents get broad API keys or an ungoverned MCP server"],
  ["Citations checked against the source document, with no model involved", "Citations, if any, are the model's word"],
  ["Workflows composed as documents from tools", "Workflows written as application code"],
  ["Every step recorded: model, tokens, cost, attempts", "Logs, if someone added them"],
  ["Benchmarks, judges and optimization built in", "Separate evaluation tools, bolted on"],
  ["Changes proven on a benchmark before promotion", "Prompt and model swaps go straight to production"],
  ["Mix models per step, with explicit failover", "One provider per app; an outage means downtime"],
  ["Interrupted runs resume from a journal", "Restart from scratch"],
  ["Same engine on a laptop and on AWS", "Separate stories for development and the cloud"],
];

const roadmap = [
  { when: "1.4", name: "A visual interface", text: "Compose and test workflows without the command line." },
  { when: "1.5", name: "Audio and video input", text: "The same evidence trail for recordings that 1.3 brings to documents." },
  { when: "Planned", name: "MCP server in the AWS template", text: "Run the agent server from the same CloudFormation stack as the workers." },
  { when: "Planned", name: "Cthulhu", text: "A paid optimizer that improves prompts, structure and escalation, not just model choice." },
];
---

<Layout
  title="Azathoth"
  description={`Azathoth ${azathoth.version} is an open-source engine that runs AI workflows as versioned specifications and improves them only from evidence. It reads documents, checks every citation against the source page, and serves promoted workflows to AI agents as governed MCP tools.`}
>
  <section class="hero section-dark">
    <Tendrils />

    <div class="site-container hero-inner">
      <a class="pill" href="#documents">
        Version {azathoth.version}{azathoth.releaseName && ` · “${azathoth.releaseName}”`}: reads documents and cites the page
      </a>

      <h1 class="display">
        Take your AI workflows back
        <span class="signal">from the providers.</span>
      </h1>

      <p class="lede">
        Azathoth is an open-source engine that runs AI workflows as durable,
        versioned specifications, and improves them only from evidence.
        You own the workflow. Every change is proven before it ships.
      </p>

      <div class="actions">
        <a
          class="button button-signal"
          href={site.booking}
          target="_blank"
          rel="noreferrer"
        >
          {site.bookingLabel}
          <span aria-hidden="true">↗</span>
        </a>

        <a
          class="button button-ghost"
          href={azathoth.repo}
          target="_blank"
          rel="noreferrer"
        >
          View on GitHub
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <p class="hero-install">
        <code>pip install {azathoth.pypiName}</code>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="site-container split">
      <div>
        <p class="eyebrow">The bet</p>
        <h2 class="heading">Models answer prompts. The engine does the rest.</h2>
      </div>

      <div class="prose">
        <p>
          In most AI systems, the model drives: it decides what to do next,
          calls tools, and talks to the user. That makes it hard to see what
          happened, harder to swap models, and impossible to measure.
        </p>

        <p>
          Azathoth flips that. The engine holds the full context, runs the
          tools itself, and gives each model only what its step needs.
          Models never act as agents and never change the workflow.
        </p>

        <p class="emphasis">
          So every step is observable, swappable and measurable, and that
          is what makes evidence-driven optimization possible.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="site-container">
      <div class="block-heading">
        <p class="eyebrow eyebrow-light">How it works</p>
        <h2 class="heading">Six stages. One record of everything.</h2>
        <p class="lede">
          Each stage is kept separate: a specification never mixes with its
          evidence, and nothing but promotion grants production authority.
          Every value a step saw can be traced to the step that produced it.
        </p>
      </div>

      <Lifecycle
        stages={lifecycle}
        label="Compose, run, benchmark, optimize, promote, invoke: every stage writes to one evidence store"
      />
    </div>
  </section>

  <section class="section documents" id="documents">
    <div class="site-container">
      <div class="split block-split">
        <div>
          <p class="eyebrow">New in 1.3 · Documents</p>
          <h2 class="heading">Every answer, traced to the page it came from.</h2>
        </div>

        <p class="lede">
          Workflows now read PDFs and images and keep the evidence of where
          each answer came from. A citation is only kept once it's been
          checked against the document's own text, with no model involved.
        </p>
      </div>

      <ol class="guarantees four">
        {
          documentFlow.map((item, index) => (
            <li>
              <span class="guarantee-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="doc-close">
        <p>
          A citation that doesn't check out can fail the step and retry, or
          be kept for a later step to judge. Benchmarks and optimization
          score the share of verified citations beside quality,
          reliability, latency and cost, so you can see whether a cheaper
          model still cites its sources.
        </p>

        <div class="actions">
          <a
            class="button button-primary"
            href={azathoth.documentsGuide}
            target="_blank"
            rel="noreferrer"
          >
            Read the documents guide
            <span aria-hidden="true">↗</span>
          </a>

          <a class="button button-secondary" href="/workwithus#engagements">
            Document Evidence Pilot
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <p class="eyebrow">Who does what</p>
      <h2 class="heading narrow">AI work moves out of application code and into operations.</h2>

      <div class="roles">
        {
          roles.map((role) => (
            <article>
              <p class="role-who">{role.who}</p>
              <h3>{role.does}</h3>
              <p>{role.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section features">
    <div class="site-container">
      <div class="split block-split">
        <div>
          <p class="eyebrow">What ships in {azathoth.version}</p>
          <h2 class="heading">Ready to run today.</h2>
        </div>

        <p class="lede">
          Everything below is in the current release, open source and
          installable now.
        </p>
      </div>

      <div class="feature-grid">
        {
          highlights.map((group) => (
            <article class="feature-new">
              <p class="new-label">{group.label}</p>
              <h3>{group.area}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }

        {
          features.map((group) => (
            <article>
              <h3>{group.area}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-accent aws">
    <div class="site-container split">
      <div>
        <p class="eyebrow eyebrow-light">First-class on AWS</p>
        <h2 class="heading">A better home for AI workflows than Step Functions.</h2>
      </div>

      <div class="prose">
        <p>
          Azathoth works with Amazon Bedrock models, an SQS queue worker,
          S3 inputs and PostgreSQL, and adds what Step Functions doesn't
          have: model choice, benchmarking and optimization.
        </p>

        <p>
          A CloudFormation template for AWS Fargate is included, with job
          queues, an encrypted evidence bucket, least-privilege access and
          autoscaling workers.
        </p>

        <p class="emphasis">
          End-to-end AWS validation of the template is in progress.
        </p>

        <ul class="aws-list">
          <li>Amazon Bedrock</li>
          <li>SQS worker</li>
          <li>S3 inputs</li>
          <li>PostgreSQL</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section agents" id="agents">
    <div class="site-container">
      <div class="split block-split">
        <div>
          <p class="eyebrow">Agents (MCP)</p>
          <h2 class="heading">Give agents your workflows, not your keys.</h2>
        </div>

        <p class="lede">
          <code>{mcp.pypiName}</code> serves your promoted workflows as
          tools for AI clients: Claude Desktop, your IDE, or your own
          agents. It's Azathoth's promotion rule, extended to agents.
          Nothing runs that wasn't promoted. Nothing is exposed that wasn't
          listed.
        </p>
      </div>

      <ol class="guarantees">
        {
          guarantees.map((item, index) => (
            <li>
              <span class="guarantee-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="modes">
        <article>
          <p class="mode-label">Local · stdio</p>
          <h3>One person, one client</h3>
          <p>
            For a single local client such as Claude Desktop. It uses the
            same environment as the CLI, and the guide covers setup on
            macOS and Windows.
          </p>
        </article>

        <article class="mode-team">
          <p class="mode-label">Team · Streamable HTTP</p>
          <h3>One shared server, behind your identity provider</h3>
          <p>
            Usually on PostgreSQL, in front of Entra ID, Okta, Cognito or
            Keycloak. It accepts only signed, unexpired tokens issued for
            this server and never issues tokens itself. Without an identity
            provider, it only listens on the local machine.
          </p>
        </article>
      </div>

      <div class="mcp-start">
        <div class="mcp-commands">
          <div class="command" aria-label="Install the MCP server">
            <code>pip install {mcp.pypiName}</code>
          </div>
          <div class="command" aria-label="Start the MCP server">
            <code>{mcp.command}</code>
          </div>
        </div>

        <div>
          <p class="mcp-note">
            Callers pass inline values only. The server never reads files
            or references on a caller's behalf.
          </p>

          <div class="actions">
            <a
              class="button button-primary"
              href={mcp.guide}
              target="_blank"
              rel="noreferrer"
            >
              Read the MCP guide
              <span aria-hidden="true">↗</span>
            </a>

            {
              azathoth.demoVideoUrl && (
                <a
                  class="button button-secondary"
                  href={azathoth.demoVideoUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  Watch the 60-second demo
                  <span aria-hidden="true">↗</span>
                </a>
              )
            }

            <a class="button button-secondary" href="/workwithus#engagements">
              Agent Access Pilot
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <div class="mcp-calling">
        <div>
          <p class="mode-label">New in 1.3 · The other direction</p>
          <h3>Workflows can call MCP tools too.</h3>
        </div>

        <div>
          <p>
            A workflow step can call a tool that another MCP server serves,
            over stdio or HTTP. Each step is pinned to a digest of that
            tool's schemas, so if the server changes the tool, the step
            stops instead of sending it bad arguments.
            <code>azathoth tool from-mcp</code> writes the tool's document
            for you.
          </p>

          <a
            class="text-link"
            href={azathoth.mcpToolsGuide}
            target="_blank"
            rel="noreferrer"
          >
            Calling MCP tools <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <p class="eyebrow">The difference</p>
      <h2 class="heading narrow">Measurement, versioning and deployment are part of the architecture.</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Azathoth</th>
              <th scope="col">The typical alternative</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map(([ours, theirs]) => (
                <tr>
                  <td>{ours}</td>
                  <td>{theirs}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="split block-split">
        <div>
          <p class="eyebrow">Examples that ship</p>
          <h2 class="heading">See it work.</h2>
        </div>

        <p class="lede">
          Real, runnable workflows come in the box, from small learning
          examples to a workflow that writes other workflows.
        </p>
      </div>

      <div class="example-grid">
        {
          examples.map((example) => (
            <article>
              <h3>{example.name}</h3>
              <p>{example.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-dark rule">
    <Tendrils side="left" />

    <div class="site-container rule-inner">
      <p class="eyebrow eyebrow-light">The operating rule</p>
      <blockquote>
        Configure explicitly. Execute empirically. Optimize without hidden
        deployment. Promote deliberately. Invoke exactly what production
        state says to invoke.
      </blockquote>
    </div>
  </section>

  <section class="section">
    <div class="site-container split">
      <div>
        <p class="eyebrow">Coming next</p>
        <h2 class="heading">Where Azathoth is headed.</h2>
        <p class="lede">
          Planned, not yet released. Follow along on GitHub.
        </p>
      </div>

      <div class="roadmap">
        {
          roadmap.map((item) => (
            <article>
              <p class="soon">{item.when}</p>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section get-started">
    <div class="site-container split">
      <div>
        <p class="eyebrow">Get started</p>
        <h2 class="heading">Install in one line.</h2>

        <p class="lede">
          Built in public, solo, from August 1, 2026 to {azathoth.version}
          in just over three months, with more than a hundred architecture
          decision records and every provider faked in tests.
        </p>
      </div>

      <div class="install">
        <div class="command" aria-label="Install the engine">
          <code>pip install {azathoth.pypiName}</code>
        </div>
        <div class="command second" aria-label="Install the MCP server">
          <code>pip install {mcp.pypiName}</code>
        </div>
        <p class="install-note">
          Released together, always at the same version.
        </p>

        <dl class="facts">
          <div>
            <dt>Optional extras</dt>
            <dd>
              {azathoth.extras.map((extra) => <code>[{extra}]</code>)}
            </dd>
          </div>
          <div>
            <dt>Container</dt>
            <dd>
              <code>{azathoth.image}</code>
              <span class="fact-note">{azathoth.imageNote}</span>
            </dd>
          </div>
          <div>
            <dt>Upgrading</dt>
            <dd>
              Nothing changes for an existing installation. Upgrade, then run
              <code>azathoth init</code>.
            </dd>
          </div>
          <div>
            <dt>Platforms</dt>
            <dd>macOS, Linux, Windows · Python up to 3.13</dd>
          </div>
          <div>
            <dt>Storage</dt>
            <dd>SQLite by default, PostgreSQL 15+</dd>
          </div>
        </dl>

        <div class="actions">
          <a
            class="button button-primary"
            href={azathoth.repo}
            target="_blank"
            rel="noreferrer"
          >
            Read the docs on GitHub
            <span aria-hidden="true">↗</span>
          </a>

          <a
            class="button button-secondary"
            href={azathoth.changelog}
            target="_blank"
            rel="noreferrer"
          >
            Changelog
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark closing">
    <Tendrils />

    <div class="site-container closing-inner">
      <div>
        <p class="eyebrow eyebrow-light">Want a hand?</p>
        <h2 class="heading">We'll put Azathoth to work on your workflow.</h2>
      </div>

      <div class="actions">
        <a class="button button-signal" href="/workwithus">
          Work with us
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-inner {
    position: relative;
    padding-block: clamp(6rem, 12vw, 11rem);
  }

  .hero .display {
    max-width: 1050px;
    margin-top: 2.25rem;
    font-size: clamp(3rem, 7.5vw, 7rem);
  }

  .signal {
    display: block;
    color: var(--color-signal);
  }

  .hero-install {
    margin: 2.5rem 0 0;
    color: var(--color-sage);
    font-size: 0.95rem;
  }

  .hero-install code::before {
    content: "$ ";
    opacity: 0.6;
  }

  .block-heading {
    max-width: 840px;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .block-split {
    align-items: end;
  }

  .block-split .lede {
    margin: 0;
  }

  .narrow {
    max-width: 900px;
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--color-border);
  }

  .roles article {
